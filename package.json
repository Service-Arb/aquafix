{
  "name": "aquafix",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "BlueOak-1.0.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "palette": "evinvest-palette --brand aquafix --out app/brand.css assets/brand.toml",
    "dev": "npm run palette && next dev",
    "build": "npm run palette && next build",
    "postbuild": "rm -rf .next/standalone/.next/static && cp -R .next/static .next/standalone/.next/static",
    "start": "node .next/standalone/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "size": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/bundle-budget.ts",
    "photos": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/photos.ts"
  },
  "dependencies": {
    "@evinvest/analytics": "^0.3.0",
    "@evinvest/i18n": "^0.9.0",
    "@evinvest/kitstart": "file:vendor/evinvest/evinvest-kitstart-0.1.0.tgz",
    "@evinvest/marketing": "file:vendor/evinvest/evinvest-marketing-0.3.0.tgz",
    "@evinvest/uikit": "file:vendor/evinvest/evinvest-uikit-0.20.0.tgz",
    "motion": "^13.4.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
