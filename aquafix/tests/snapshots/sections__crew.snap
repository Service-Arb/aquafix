source: aquafix/tests/sections.rs
expression: render(app)
---
<section id="crew" class="w-full px-[var(--page-px)] light bg-background text-ink py-[var(--band-py-tight)]" data-slot="section"><div class="flex flex-col gap-6 md:gap-11"><div class="flex flex-col gap-2 md:gap-3.5" data-slot="section-head"><p class="font-medium text-[10px] md:text-[11.5px] tracking-[0.15em] md:tracking-[0.16em] text-primary" data-slot="eyebrow">THE PEOPLE WHO WILL BE IN YOUR HOUSE</p><h2 class="font-display [font-weight:700] max-w-[54rem] tracking-[-0.005em] leading-[1.16] md:leading-[1.14] text-[calc(1.5625rem*var(--display-scale))] md:text-[calc(2.625rem*var(--display-scale))]" data-slot="display">Four plumbers. That is the whole company.</h2><p class="max-w-[52rem] text-[15px] md:text-[17px] leading-[1.58] text-ink-soft">No subcontractors, no rotating strangers off an app. You will meet one of these four, and you will know which one before they knock.</p></div><div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4"><div id="crew-MH" class="flex flex-col gap-4 rounded-[14px] border border-border bg-card px-6 py-[26px]"><div class="flex size-[66px] items-center justify-center rounded-full bg-brand font-display text-[22px] font-bold text-primary">MH</div><div class="flex flex-col gap-[5px]"><p class="font-display text-[20px] font-bold text-ink">Marcus Hale</p><p class="text-[14px] font-medium text-ink-soft">Owner · Master Plumber</p></div><div class="flex flex-col gap-[5px] text-[13.5px] text-ink-mid"><p>19 years on the tools</p><p>Licence #PL-40219</p></div></div><div id="crew-NE" class="flex flex-col gap-4 rounded-[14px] border border-border bg-card px-6 py-[26px]"><div class="flex size-[66px] items-center justify-center rounded-full bg-brand font-display text-[22px] font-bold text-primary">NE</div><div class="flex flex-col gap-[5px]"><p class="font-display text-[20px] font-bold text-ink">Nate Ellis</p><p class="text-[14px] font-medium text-ink-soft">Lead Plumber</p></div><div class="flex flex-col gap-[5px] text-[13.5px] text-ink-mid"><p>11 years on the tools</p><p>Licence #PL-51882</p></div></div><div id="crew-DO" class="flex flex-col gap-4 rounded-[14px] border border-border bg-card px-6 py-[26px]"><div class="flex size-[66px] items-center justify-center rounded-full bg-brand font-display text-[22px] font-bold text-primary">DO</div><div class="flex flex-col gap-[5px]"><p class="font-display text-[20px] font-bold text-ink">Deb Ovechi</p><p class="text-[14px] font-medium text-ink-soft">Plumber · Gas Fitter</p></div><div class="flex flex-col gap-[5px] text-[13.5px] text-ink-mid"><p>8 years on the tools</p><p>Licence #PL-60114</p></div></div><div id="crew-TR" class="flex flex-col gap-4 rounded-[14px] border border-border bg-card px-6 py-[26px]"><div class="flex size-[66px] items-center justify-center rounded-full bg-brand font-display text-[22px] font-bold text-primary">TR</div><div class="flex flex-col gap-[5px]"><p class="font-display text-[20px] font-bold text-ink">Toby Ruiz</p><p class="text-[14px] font-medium text-ink-soft">Apprentice, 3rd year</p></div><div class="flex flex-col gap-[5px] text-[13.5px] text-ink-mid"><p>3 years on the tools</p><p>Always supervised</p></div></div></div></div></section>
