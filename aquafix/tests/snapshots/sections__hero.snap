<section class="w-full px-[var(--page-px)] dark bg-background text-ink py-[var(--band-py)] relative overflow-hidden" data-slot="section"><span class="mark pointer-events-none absolute -left-24 -top-16 h-[520px] w-[450px] text-primary opacity-[0.06] md:-left-45 md:-top-30 md:h-[760px] md:w-[658px] inline-block"><svg xmlns="http://www.w3.org/2000/svg" width="86.6" height="100" viewBox="0 0 86.6 100"><path fill-rule="evenodd" d="M43.3 0L86.6 25V75L43.3 100L0 75V25L43.3 0ZM43.3 20C48 35.06 63.46 44.02 63.46 56.9C63.46 68.03 54.43 77.06 43.3 77.06C32.17 77.06 23.14 68.03 23.14 56.9C23.14 44.02 38.6 35.06 43.3 20Z" fill="currentColor"/></svg>
</span><div class="relative flex flex-col gap-8 md:flex-row md:items-stretch md:gap-9"><div class="flex w-full flex-col gap-4 md:w-[656px] md:gap-[18px]"><p class="text-[10px] md:text-[11.5px] font-medium tracking-[0.14em] text-primary">LICENSED #PL-40219   ·   $2M INSURED   ·   4,100 JOBS SINCE 2011</p><h1 class="font-display font-bold text-[30px] md:text-[46px] leading-[1.08] tracking-[-0.01em] text-ink">Your plumbing fixed today — at a price we agree before we start.</h1><p class="hidden md:block text-[17px] leading-[1.58] text-ink-soft">Written flat rate on your doorstep. 2-hour arrival window. 12-month warranty. Late and the call-out is free.</p><div class="flex flex-col gap-3 text-[14px] md:text-[16px]"><div class="flex items-center gap-3"><span class="font-semibold text-positive" data-slot="check" aria-hidden="true">✓</span><span class="font-medium text-ink">Flat rate in writing — the number never moves</span></div><div class="flex items-center gap-3"><span class="font-semibold text-positive" data-slot="check" aria-hidden="true">✓</span><span class="font-medium text-ink">2-hour arrival window, or the call-out is free</span></div><div class="flex items-center gap-3"><span class="font-semibold text-positive" data-slot="check" aria-hidden="true">✓</span><span class="font-medium text-ink">12-month workmanship warranty, parts included</span></div></div><div class="hidden md:flex items-center gap-3.5"><a class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-[var(--control-radius)] transition-all cursor-pointer disabled:pointer-events-none disabled:opacity-50 [&#38;_svg]:pointer-events-none [&#38;_svg:not([class*=&#39;size-&#39;])]:size-4 shrink-0 [&#38;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-[3px] aria-invalid:ring-accent-error/20 aria-invalid:border-accent-error bg-primary text-on-primary hover:bg-primary/90 px-[var(--control-px)] py-[var(--control-py)] text-[length:var(--control-text)] [font-weight:600]" data-slot="button" href="#quote">Get my flat price  →</a><a class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-[var(--control-radius)] transition-all cursor-pointer disabled:pointer-events-none disabled:opacity-50 [&#38;_svg]:pointer-events-none [&#38;_svg:not([class*=&#39;size-&#39;])]:size-4 shrink-0 [&#38;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-[3px] aria-invalid:ring-accent-error/20 aria-invalid:border-accent-error border bg-transparent shadow-xs hover:bg-hover hover:text-ink px-[var(--control-px)] py-[var(--control-py)] text-[length:var(--control-text)] [font-weight:600]" data-slot="button" href="tel:+15035550148">(503) 555-0148</a></div><div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[13px] md:text-[14px] text-ink"><span class="flex items-center gap-[7px] whitespace-nowrap" data-slot="stat"><span class="font-semibold">★★★★★  4.9</span><span class="text-ink-soft">612 Google reviews</span></span><span class="text-border">|</span><span class="flex items-center gap-[7px] whitespace-nowrap" data-slot="stat"><span class="font-semibold">43 min</span><span class="text-ink-soft">average arrival</span></span><span class="text-border">|</span><span class="flex items-center gap-[7px] whitespace-nowrap" data-slot="stat"><span class="font-semibold">96%</span><span class="text-ink-soft">fixed same day</span></span></div></div><form id="quote" method="post" action="/quote" class="light flex w-full flex-col gap-5 rounded-[18px] bg-background text-ink px-6 py-7 shadow-[0_20px_48px_0_rgba(0,13,31,0.34)] md:w-[480px] md:px-[34px] md:pb-[30px] md:pt-8"><div class="flex flex-col gap-[7px]"><p class="font-display text-[24px] font-bold text-ink md:text-[30px]">Get your flat price</p><p class="text-[15px] text-ink-soft">90 seconds. No obligation, no call-out fee.</p></div><label class="flex w-full flex-col gap-2"><span class="text-[12.5px] font-medium tracking-[0.06em] text-ink-mid">WHAT&#39;S WRONG?</span><select class="h-auto rounded-[9px] bg-card px-4 py-[15px] text-[16px] md:text-[16px] shadow-none" name="job" required=true><option value="blocked_drain">Blocked drain</option><option value="burst_pipe">Burst or leaking pipe</option><option value="hot_water">Hot water</option><option value="tap_toilet">Tap, toilet or cistern</option><option value="sewer_line">Sewer line</option><option value="leak_detection">Leak detection</option><option value="repipe">Whole-house repipe</option><option value="fit_out">Bathroom or kitchen fit-out</option><option value="other">Something else</option></select></label><label class="flex w-full flex-col gap-2"><span class="text-[12.5px] font-medium tracking-[0.06em] text-ink-mid">WHERE ARE YOU?</span><input type="text" class="file:text-ink placeholder:text-ink-soft selection:bg-primary selection:text-on-primary border-input w-full min-w-0 border transition-[color,box-shadow] outline-none file:inline-flex file:h-7 file:border-0 file:bg-transparent file:text-sm file:font-medium disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 focus-visible:border-ring focus-visible:ring-[3px] aria-invalid:ring-accent-error/20 aria-invalid:border-accent-error h-auto rounded-[9px] bg-card px-4 py-[15px] text-[16px] md:text-[16px] shadow-none" data-slot="input" name="zip" required=true placeholder="Suburb or ZIP code" value=""/></label><label class="flex w-full flex-col gap-2"><span class="text-[12.5px] font-medium tracking-[0.06em] text-ink-mid">MOBILE</span><input type="tel" class="file:text-ink placeholder:text-ink-soft selection:bg-primary selection:text-on-primary border-input w-full min-w-0 border transition-[color,box-shadow] outline-none file:inline-flex file:h-7 file:border-0 file:bg-transparent file:text-sm file:font-medium disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 focus-visible:border-ring focus-visible:ring-[3px] aria-invalid:ring-accent-error/20 aria-invalid:border-accent-error h-auto rounded-[9px] bg-card px-4 py-[15px] text-[16px] md:text-[16px] shadow-none" data-slot="input" name="mobile" required=true placeholder="(503) 000-0000" value=""/></label><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-[var(--control-radius)] transition-all cursor-pointer disabled:pointer-events-none disabled:opacity-50 [&#38;_svg]:pointer-events-none [&#38;_svg:not([class*=&#39;size-&#39;])]:size-4 shrink-0 [&#38;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-[3px] aria-invalid:ring-accent-error/20 aria-invalid:border-accent-error bg-primary text-on-primary hover:bg-primary/90 px-[var(--control-px)] py-[var(--control-py)] text-[length:var(--control-text)] w-full [font-weight:600]" data-slot="button" type="submit">Send me my price  →</button><p class="text-[13px] leading-[1.52] text-ink-soft">We text your price band back within 10 minutes, 7am–9pm. Emergency right now? Call (503) 555-0148 — we pick up 24/7.</p><div class="h-px w-full bg-border"></div><div class="flex items-center gap-2.5"><span class="font-semibold text-positive" data-slot="check" aria-hidden="true">✓</span><span class="text-[13px] font-medium text-ink-mid">Your number is used to send the quote. Nothing else, ever.</span></div></form><img src="/assets/photos/hero.jpg" alt="An Aquafix plumber fitting a manifold on a hot-water system." class="hidden min-w-0 flex-1 rounded-[18px] object-cover object-[58%_38%] 3xl:block"/></div></section>
