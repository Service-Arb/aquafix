<section id="prices" class="w-full px-[var(--page-px)] light bg-card text-ink py-[var(--band-py)]" data-slot="section"><div class="flex flex-col gap-5 md:gap-7"><div class="flex flex-col gap-2 md:gap-3.5" data-slot="section-head"><p class="font-medium text-[10px] md:text-[11.5px] tracking-[0.15em] md:tracking-[0.16em] text-primary" data-slot="eyebrow">NO SURPRISES</p><h2 class="font-display [font-weight:700] max-w-[54rem] tracking-[-0.005em] leading-[1.16] md:leading-[1.14] text-[calc(1.5625rem*var(--display-scale))] md:text-[calc(2.625rem*var(--display-scale))]" data-slot="display">What things actually cost.</h2><p class="max-w-[52rem] text-[15px] md:text-[17px] leading-[1.58] text-ink-soft">Real flat rates from our last 500 jobs. Your price is signed on your doorstep before we start, and it does not move.</p></div><div class="overflow-hidden rounded-[14px] border border-border bg-background"><div class="relative w-full overflow-x-auto" data-slot="table-container"><table class="w-full caption-bottom text-sm border-collapse text-left" data-slot="table"><thead class="[&#38;_tr]:border-b" data-slot="table-header"><tr class="hover:bg-muted/50 data-[state=selected]:bg-muted border-b transition-colors bg-muted text-[10.5px] md:text-[11.5px] font-medium tracking-[0.14em] text-ink-soft" data-slot="table-row"><th class="text-left align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] h-auto px-4 py-3 md:px-[30px] md:py-4 font-medium text-ink-soft" data-slot="table-head">JOB</th><th class="align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] h-auto px-4 py-3 md:px-[30px] md:py-4 text-right font-medium md:w-[190px] text-ink-soft" data-slot="table-head">FLAT PRICE FROM</th><th class="align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] hidden md:table-cell h-auto px-[30px] py-4 text-right font-medium w-[200px] text-ink-soft" data-slot="table-head">TYPICAL TIME ON SITE</th></tr></thead><tbody class="[&#38;_tr:last-child]:border-0" data-slot="table-body"><tr class="hover:bg-muted/50 data-[state=selected]:bg-muted border-b transition-colors" data-slot="table-row"><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] px-4 py-3 md:px-[30px] md:py-3.5 text-[14px] md:text-[16px] font-semibold text-ink" data-slot="table-cell">Blocked drain — machine cleared</td><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] px-4 py-3 md:px-[30px] md:py-3.5 text-right text-[17px] md:text-[19px] font-bold text-primary" data-slot="table-cell">$149</td><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] hidden md:table-cell px-[30px] py-3.5 text-right text-[15px] text-ink-soft" data-slot="table-cell">45–90 min</td></tr><tr class="hover:bg-muted/50 data-[state=selected]:bg-muted border-b transition-colors" data-slot="table-row"><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] px-4 py-3 md:px-[30px] md:py-3.5 text-[14px] md:text-[16px] font-semibold text-ink" data-slot="table-cell">Leaking tap, mixer or cistern</td><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] px-4 py-3 md:px-[30px] md:py-3.5 text-right text-[17px] md:text-[19px] font-bold text-primary" data-slot="table-cell">$129</td><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] hidden md:table-cell px-[30px] py-3.5 text-right text-[15px] text-ink-soft" data-slot="table-cell">30–60 min</td></tr><tr class="hover:bg-muted/50 data-[state=selected]:bg-muted border-b transition-colors" data-slot="table-row"><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] px-4 py-3 md:px-[30px] md:py-3.5 text-[14px] md:text-[16px] font-semibold text-ink" data-slot="table-cell">Toilet repair or full replacement</td><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] px-4 py-3 md:px-[30px] md:py-3.5 text-right text-[17px] md:text-[19px] font-bold text-primary" data-slot="table-cell">$189</td><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] hidden md:table-cell px-[30px] py-3.5 text-right text-[15px] text-ink-soft" data-slot="table-cell">1–2 hrs</td></tr><tr class="hover:bg-muted/50 data-[state=selected]:bg-muted border-b transition-colors" data-slot="table-row"><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] px-4 py-3 md:px-[30px] md:py-3.5 text-[14px] md:text-[16px] font-semibold text-ink" data-slot="table-cell">Hot water system — repair</td><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] px-4 py-3 md:px-[30px] md:py-3.5 text-right text-[17px] md:text-[19px] font-bold text-primary" data-slot="table-cell">$215</td><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] hidden md:table-cell px-[30px] py-3.5 text-right text-[15px] text-ink-soft" data-slot="table-cell">1–3 hrs</td></tr><tr class="hover:bg-muted/50 data-[state=selected]:bg-muted border-b transition-colors" data-slot="table-row"><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] px-4 py-3 md:px-[30px] md:py-3.5 text-[14px] md:text-[16px] font-semibold text-ink" data-slot="table-cell">Hot water system — full replacement</td><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] px-4 py-3 md:px-[30px] md:py-3.5 text-right text-[17px] md:text-[19px] font-bold text-primary" data-slot="table-cell">$1,290</td><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] hidden md:table-cell px-[30px] py-3.5 text-right text-[15px] text-ink-soft" data-slot="table-cell">half day</td></tr><tr class="hover:bg-muted/50 data-[state=selected]:bg-muted border-b transition-colors" data-slot="table-row"><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] px-4 py-3 md:px-[30px] md:py-3.5 text-[14px] md:text-[16px] font-semibold text-ink" data-slot="table-cell">Burst or leaking pipe repair</td><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] px-4 py-3 md:px-[30px] md:py-3.5 text-right text-[17px] md:text-[19px] font-bold text-primary" data-slot="table-cell">$265</td><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] hidden md:table-cell px-[30px] py-3.5 text-right text-[15px] text-ink-soft" data-slot="table-cell">1–3 hrs</td></tr><tr class="hover:bg-muted/50 data-[state=selected]:bg-muted border-b transition-colors" data-slot="table-row"><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] px-4 py-3 md:px-[30px] md:py-3.5 text-[14px] md:text-[16px] font-semibold text-ink" data-slot="table-cell">CCTV drain camera inspection</td><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] px-4 py-3 md:px-[30px] md:py-3.5 text-right text-[17px] md:text-[19px] font-bold text-primary" data-slot="table-cell">$199</td><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] hidden md:table-cell px-[30px] py-3.5 text-right text-[15px] text-ink-soft" data-slot="table-cell">45 min</td></tr><tr class="hover:bg-muted/50 data-[state=selected]:bg-muted border-b transition-colors" data-slot="table-row"><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] px-4 py-3 md:px-[30px] md:py-3.5 text-[14px] md:text-[16px] font-semibold text-ink" data-slot="table-cell">Sewer line clear and report</td><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] px-4 py-3 md:px-[30px] md:py-3.5 text-right text-[17px] md:text-[19px] font-bold text-primary" data-slot="table-cell">$390</td><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] hidden md:table-cell px-[30px] py-3.5 text-right text-[15px] text-ink-soft" data-slot="table-cell">2–4 hrs</td></tr><tr class="hover:bg-muted/50 data-[state=selected]:bg-muted border-b transition-colors" data-slot="table-row"><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] px-4 py-3 md:px-[30px] md:py-3.5 text-[14px] md:text-[16px] font-semibold text-ink" data-slot="table-cell">Full repipe — 3 bedroom house</td><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] px-4 py-3 md:px-[30px] md:py-3.5 text-right text-[17px] md:text-[19px] font-bold text-primary" data-slot="table-cell">$4,800</td><td class="p-2 align-middle whitespace-nowrap [&#38;:has([role=checkbox])]:pr-0 [&#38;&#62;[role=checkbox]]:translate-y-[2px] hidden md:table-cell px-[30px] py-3.5 text-right text-[15px] text-ink-soft" data-slot="table-cell">2–3 days</td></tr></tbody></table></div><div class="flex items-start gap-3 bg-muted px-4 py-4 md:px-[30px] md:pb-[22px] md:pt-5"><span class="font-semibold text-positive" data-slot="check" aria-hidden="true">✓</span><p class="text-[13.5px] md:text-[14.5px] font-medium leading-[1.55] text-ink-mid"><span class="md:hidden">Call-out $89, credited in full against approved work. Nights and weekends add $60.</span><span class="hidden md:inline">Call-out is $89 and is credited in full against any work you approve. Nights, weekends and public holidays add $60. That is the entire price list — there is nothing else.</span></p></div></div></div></section>
